      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Aldric Corvane",
              "text": "There is no further up. Whatever you came to say, say it here, where the house can hear it."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "I did not come to say it. I came to keep the docket."
            }
          ]
        }
      ]
    },
    {
      "id": "the-record-closes",
      "when": {
        "kind": "unitDowned",
        "unitId": "aldric"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Aldric Corvane",
              "text": "You will not be in the record, Rowen. You will be in the refinery. It is already written and filed."
            },
            {
              "speaker": "Prelate-Assayer Quill",
              "text": "The Greyfall Inquiry will find that Ensign Rowen Corvane died in the Refinery Three incident. The Sodality does not dispute findings. It files them."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Then I go down by the tradesmen's lift."
            }
          ]
        }
      ]
    }
