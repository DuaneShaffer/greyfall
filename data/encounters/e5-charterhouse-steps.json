  "endText": {
    "win": "Aldric Corvane is down on his own steps, in front of the house, with the docket open.",
    "loss": "The steps hold. Whatever was carried up them goes back down the tradesmen's lift."
  },
  "triggers": [
    {
      "id": "the-steps-are-closed",
      "when": {
        "kind": "battleStart"
      },
      "once": true,
      "actions": [
        {
          "kind": "setPower",
          "objectId": "service-lift",
          "powered": false
        },
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Watch Sergeant",
              "text": "The steps are closed, ma'am. The tradesmen's lift is cut. Turn around in the court."
            },
            {
              "speaker": "Aldric Corvane",
              "text": "Let her climb. Whatever she has brought, she can carry it up herself."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Three terraces, and he is standing on the second of them. He wants it slow and he wants it watched."
            }
          ]
        }
      ]
    },
    {
      "id": "terrace-one",
      "when": {
        "kind": "unitEntersTiles",
        "team": "player",
