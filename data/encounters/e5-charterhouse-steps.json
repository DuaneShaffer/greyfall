      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Watch Sergeant",
              "text": "She is inside the balustrade line, sir."
            },
            {
              "speaker": "Aldric Corvane",
              "text": "I can see where she is. Let her come the rest of the way up."
            }
          ]
        }
      ]
    },
    {
      "id": "terrace-two-the-proof",
      "when": {
        "kind": "unitHpBelowPercent",
        "unitId": "aldric",
        "percent": 90
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Rowen Corvane",
              "text": "Corvane requisition seals. On the charges that took four hands off Tallow Row. Your docket number, Aldric, and your yard."
            },
            {
              "speaker": "Aldric Corvane",
              "text": "Yes."
            },
            {
              "speaker": "Aldric Corvane",
              "text": "You expected me to lie about paperwork. It is a seam claim, Rowen. The Combine had to be a danger before the Council would let us take it. So it was made one."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "You had them fire on their own line."
            },
            {
              "speaker": "Aldric Corvane",
              "text": "I had it done. Where a thing is signed is not where it happens. That is the whole use of signing."
            }
          ]
        }
      ]
    },
    {
      "id": "aldric-to-the-court",
      "when": {
        "kind": "unitHpBelowPercent",
        "unitId": "aldric",
        "percent": 55
      },
      "afterTriggerId": "terrace-two-the-proof",
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Aldric Corvane",
              "text": "Up to the court. Reserve to the lamp line."
            },
            {
              "speaker": "Watch Sergeant",
              "text": "Sir."
            },
            {
              "speaker": "Aldric Corvane",
              "text": "You will have to do it on the top step, Rowen. In front of the house."
            }
          ]
        },
        {
          "kind": "moveUnit",
          "unitId": "aldric",
          "to": {
            "x": 8,
            "y": 4
          }
        },
