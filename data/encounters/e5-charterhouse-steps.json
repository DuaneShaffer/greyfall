          },
          {
            "x": 15,
            "y": 13
          }
        ]
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Watch Sergeant",
              "text": "First terrace lost. Falling back to the planter line, sir."
            },
            {
              "speaker": "Aldric Corvane",
              "text": "Nobody fires until she is inside the balustrade line. I want her heard before she is stopped."
            }
          ]
        }
      ]
    },
    {
      "id": "terrace-two-reached",
      "when": {
        "kind": "unitEntersTiles",
        "team": "player",
