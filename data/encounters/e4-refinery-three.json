  "triggers": [
    {
      "id": "under-measurement",
      "when": {
        "kind": "battleStart"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Prelate-Assayer Quill",
              "text": "The Sodality observes. It does not intervene. What this plant does today, it does under measurement."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "The bank is reading over line. Cells do not climb on their own. Somebody set them there."
            },
            {
              "speaker": "Nessa Kiln",
              "text": "The bank is reading what it was told to read, officer. Licensed, metered, and signed for."
            },
            {
              "speaker": "Watch Sergeant",
              "text": "Ma'am, our orders are the perimeter. Not the gallery."
            }
          ]
        }
      ]
    },
