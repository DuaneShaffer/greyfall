          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Nessa Kiln",
              "text": "Height buys you nothing here. The tower does not care which side of it you are standing on."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "It is not for seeing. It is the way to the board."
            }
