        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Nessa Kiln",
              "text": "Interlock is off the rack. Clear the terrace."
            },
            {
              "speaker": "Prelate-Assayer Quill",
              "text": "Recording. Rack one, first cell."
            }
          ]
        },
        {
          "kind": "destroyObject",
          "objectId": "bank-cell-one"
        },
        {
          "kind": "destroyObject",
          "objectId": "tower-walk-south"
        },
        {
          "kind": "setPower",
          "objectId": "charge-hoist-west",
          "powered": false
        },
        {
          "kind": "setPower",
          "objectId": "charge-hoist-east",
          "powered": false
        },
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Rowen Corvane",
              "text": "South walk is gone. Everyone off the ring \u2014 the hoists are dead, you go by the ramps or you stay up there."
            },
            {
              "speaker": "Prelate-Assayer Quill",
              "text": "Four cells in series, and the grid browns out on cue. Accidents are not this tidy."
            },
            {
              "speaker": "Prelate-Assayer Quill",
              "text": "The Inquiry will record this as a Combine act. I am recording what I saw. The two documents are not required to agree."
            }
          ]
        }
      ]
    },
