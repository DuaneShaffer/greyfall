        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Nessa Kiln",
              "text": "You are an hour and a half late. The load schedule was filed this morning."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Filed by whom."
            },
            {
              "speaker": "Nessa Kiln",
              "text": "Corvane Freight. Same as everything else on this floor."
            }
          ]
        }
      ]
    },
    {
      "id": "the-licence-does-not-carry-her",
      "when": {
        "kind": "unitHpBelowPercent",
        "unitId": "nessa-kiln",
        "percent": 40
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Nessa Kiln",
              "text": "I am licensed. Whatever happens on this floor, the Assay carries me."
            },
            {
              "speaker": "Prelate-Assayer Quill",
              "text": "The Sodality licenses attunement. It has never licensed conduct."
            }
          ]
        }
