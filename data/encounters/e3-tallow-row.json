  "triggers": [
    {
      "id": "foot-of-the-row",
      "when": {
        "kind": "battleStart"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Watch Sergeant",
              "text": "Tallow Row. The cell went to ground in the tenements. The House holds the writ down here; the district has no say in it."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Doors and windows. Nobody fires into a room they have not looked into first."
            },
            {
              "speaker": "Wick",
              "text": "Gas is live under the whole street, Watch. You bring a torch up here and we all render together."
            }
          ]
        }
      ]
    },
