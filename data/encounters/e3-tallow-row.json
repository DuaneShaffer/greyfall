    {
      "id": "requisition-seals",
      "when": {
        "kind": "unitEntersTiles",
        "team": "player",
        "tiles": [
          {
            "x": 3,
            "y": 3
          },
          {
            "x": 4,
            "y": 3
          },
          {
            "x": 3,
            "y": 4
          },
          {
            "x": 4,
            "y": 4
          }
        ]
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Rowen Corvane",
              "text": "The crates are stencilled. Corvane Freight. Requisition seals, and the seals are unbroken."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "These charges were signed out of my family's yard. Every one of them."
            },
            {
              "speaker": "Wick",
              "text": "You're only now reading the box? We've been carrying your name up this street for a month."
            },
            {
              "speaker": "Watch Sergeant",
              "text": "Ma'am. That is a paperwork matter."
            }
          ]
        }
      ]
    },
    {
      "id": "main-at-the-stair",
      "when": {
        "kind": "objectDestroyed",
        "objectId": "gas-main-north"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Watch Sergeant",
              "text": "Main's gone at the stair head. Hold where you are until it burns itself down."
            },
            {
              "speaker": "Wick",
              "text": "That's the whole Row's cooking gas. Somebody's supper, that."
            }
          ]
        }
      ]
    },
    {
      "id": "wick-breaks-for-the-stair",
      "when": {
        "kind": "unitHpBelowPercent",
        "unitId": "wick",
        "percent": 40
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Wick",
              "text": "That's me done standing. Stair's four doors up. I've walked it drunk."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "He is on the stair. Cut him off at the head of the Row or we lose the whole street's evidence with him."
            }
          ]
        },
        {
          "kind": "moveUnit",
          "unitId": "wick",
          "to": {
            "x": 8,
            "y": 1
          }
        }
      ]
    },
    {
      "id": "wick-down",
      "when": {
        "kind": "unitDowned",
        "unitId": "wick"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Wick",
              "text": "You want a name off me. There isn't one. There's a docket, and a yard, and a man who never comes down to the yard."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Sergeant. Bag the seals."
            },
            {
              "speaker": "Watch Sergeant",
              "text": "Evidence goes to the Watch house, ma'am. That is the procedure."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Then it goes in my coat."
            }
          ]
        }
      ]
    }
  ]
