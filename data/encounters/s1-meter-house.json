  "endText": {
    "win": "The boards are the Watch's and the struck galleries go out one after another. The tally for the night is written by somebody who was not here.",
    "loss": "The house keeps its own bus. The Watch walks back out of the doors it came in by, and the galleries stay lit."
  },
  "triggers": [
    {
      "id": "the-meter-house",
      "when": {
        "kind": "battleStart"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Watch Sergeant",
              "text": "Corvane Meter House. You are drawing off a metered bus without licence. Stand away from the boards and present your tickets."
            },
            {
              "speaker": "Nella Fen",
              "text": "Tickets. There are four galleries lit off this house tonight and there are hands down every one of them."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Put them in the dark and walk out through the south doors. Nobody has to be carried."
            },
            {
              "speaker": "Bram Coil",
              "text": "You put a gallery in the dark with hands still down it and somebody gets carried anyway. That is the whole argument, that is all it has ever been."
            },
            {
              "speaker": "Nella Fen",
              "text": "Bram, hold the east board. I have the tie."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Sergeant. The maul on the man at the stair is Watch issue."
            },
            {
              "speaker": "Watch Sergeant",
              "text": "Mauls get sold, ma'am. Form your line."
            }
          ]
        }
      ]
    },
    {
      "id": "on-the-landing",
      "when": {
        "kind": "unitEntersTiles",
        "team": "player",
        "tiles": [
          {
            "x": 7,
            "y": 7
          },
          {
            "x": 8,
            "y": 7
          },
          {
            "x": 7,
            "y": 8
          },
          {
            "x": 8,
            "y": 8
          }
        ]
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Nella Fen",
              "text": "Off the landing. That is the tie, and it is open, and it stays open."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Sergeant. What does the tie do."
            },
            {
              "speaker": "Watch Sergeant",
              "text": "Interconnection breaker, ma'am. Closed, both mains carry one bus and there is room on it. Open, each main carries its own half and neither has anything spare."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Then it is a lever and it works from this side too. Throw it."
            }
          ]
        }
      ]
    },
    {
      "id": "the-west-feeder-goes",
      "when": {
        "kind": "objectDestroyed",
        "objectId": "west-feeder"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Bram Coil",
              "text": "West trough is gone. Not cut - gone. A cut I splice. A hole stays a hole."
            },
            {
              "speaker": "Nella Fen",
              "text": "Then the west board answers to the tie now, or it answers to nothing at all."
            }
          ]
        }
      ]
    },
    {
      "id": "the-east-feeder-goes",
      "when": {
        "kind": "objectDestroyed",
        "objectId": "east-feeder"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Bram Coil",
              "text": "East trough with it. That is the pump and the apron lamp off the east main for good."
            },
            {
              "speaker": "Nella Fen",
              "text": "Sump run hangs on the east board and the east board hangs on the tie. Watch the load, Bram."
            }
          ]
        }
      ]
    },
    {
      "id": "the-house-comes-back",
      "when": {
        "kind": "turnStart",
        "turn": 24
      },
      "once": true,
      "actions": [
        {
          "kind": "setPower",
          "objectId": "west-main",
          "powered": true
        },
        {
          "kind": "setPower",
          "objectId": "east-main",
          "powered": true
        },
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Nella Fen",
              "text": "Both mains are back in. The Meter keeps a spare key to either cutout and a boy who only has to walk four steps."
            },
            {
              "speaker": "Watch Sergeant",
              "text": "Then we will be here a while, ma'am."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Pulling a main is a delay. Standing on the boards is the job. Take the boards."
            }
          ]
        }
      ]
    },
