    {
      "id": "nella-goes-down",
      "when": {
        "kind": "unitDowned",
        "unitId": "crew-sparker-nella"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Bram Coil",
              "text": "Nella. Nella, look at me."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Log her. Nella Fen, Combine of Trades, meter house, this hour."
            },
            {
              "speaker": "Watch Sergeant",
              "text": "The Assay will have her filed as a sparker whatever we write, ma'am. Licence is the only word they keep."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Then write both and let them disagree in the Archive."
            }
          ]
        }
