  "endText": {
    "win": "Floor Nine holds. What was set to burn is out, and the shift is still standing on it.",
    "loss": "Floor Nine goes to them with the shift still on it."
  },
  "triggers": [
    {
      "id": "south-doors",
      "when": {
        "kind": "battleStart"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Watch Sergeant",
              "text": "Floor Nine. Stand down and clear the aisle. You are in breach of the charter's labour terms."
            },
            {
              "speaker": "Jory Slate",
              "text": "The floor's still running, Rowen. Nobody shut the tap off. Ask yourself who wants it hot in here."
            },
            {
              "speaker": "Rowen Corvane",
              "text": "Then get behind the presses, Jory."
            },
            {
              "speaker": "Jory Slate",
              "text": "There's no behind on a press line. There's in front of it and there's in it."
            },
            {
              "speaker": "Provocateur Foreman",
              "text": "Hold the aisle. Let them come up under the ladle."
            }
          ]
        }
      ]
    },
    {
      "id": "aisle-mouth",
      "when": {
        "kind": "unitEntersTiles",
        "team": "player",
        "tiles": [
          {
            "x": 6,
            "y": 11
          },
          {
            "x": 7,
            "y": 11
          },
          {
            "x": 8,
            "y": 11
          },
          {
            "x": 9,
            "y": 11
          }
        ]
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Perren Ash",
              "text": "Ladle's coming over! Off the channel, all of you, off the channel!"
            },
            {
              "speaker": "Rowen Corvane",
              "text": "He warned us. Whoever writes this up, that goes in it."
            }
          ]
        }
      ]
    },
    {
      "id": "bridge-in-the-bay",
      "when": {
        "kind": "objectDestroyed",
        "objectId": "bay-bridge"
      },
      "once": true,
      "actions": [
        {
          "kind": "dialogue",
          "lines": [
            {
              "speaker": "Watch Sergeant",
              "text": "Bridge is in the melt bay. Nothing crosses east now."
            },
            {
              "speaker": "Jory Slate",
              "text": "That wasn't us. We work here."
            }
          ]
        }
      ]
    },
